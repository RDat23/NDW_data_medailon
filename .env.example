# Kopieer dit bestand naar .env en vul lokale wachtwoorden in.

# Versies voor de Docker Compose-services
POSTGRES_VERSION=16.15
# Vervang bij een gecontroleerde upgrade met de nieuw geverifieerde digest.
MINIO_IMAGE=firstfinger/minio@sha256:94c7aba0dbacd0ad6ddd2d50a86a4bab3c86b2e29926234359fb42c1429e35a6
DBT_POSTGRES_VERSION=1.11.0

# PostgreSQL
POSTGRES_DB=ndw
POSTGRES_USER=ndw_admin
POSTGRES_PASSWORD=kies_een_lokaal_wachtwoord
POSTGRES_PORT=5433

# MinIO
MINIO_ROOT_USER=ndw_minio_admin
MINIO_ROOT_PASSWORD=kies_een_lokaal_wachtwoord_van_minimaal_8_tekens
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ADMIN_CONSOLE_PORT=9002
MINIO_INGEST_USER=ndw_ingest
MINIO_INGEST_PASSWORD=kies_een_ingest_wachtwoord
MINIO_TRANSFORM_USER=ndw_transform
MINIO_TRANSFORM_PASSWORD=kies_een_transform_wachtwoord

# dbt-profiel voor lokale ontwikkeling
DBT_HOST=localhost
DBT_PORT=5433
DBT_DATABASE=ndw
DBT_SCHEMA=bronze
DBT_USER=ndw_admin
DBT_PASSWORD=kies_hetzelfde_postgres_wachtwoord

# Lightdash (alleen voor lokale ontwikkeling)
LIGHTDASH_VERSION=2.402.0
LIGHTDASH_PORT=8080
LIGHTDASH_DB_NAME=lightdash
LIGHTDASH_DB_USER=lightdash
LIGHTDASH_DB_PASSWORD=kies_een_apart_lightdash_databasewachtwoord
# Genereer bijvoorbeeld met: openssl rand -hex 32
LIGHTDASH_SECRET=kies_een_vast_geheim_van_minimaal_32_tekens
LIGHTDASH_WAREHOUSE_USER=lightdash_reader
LIGHTDASH_WAREHOUSE_PASSWORD=kies_een_readonly_wachtwoord
LIGHTDASH_S3_BUCKET=lightdash
LIGHTDASH_S3_USER=lightdash_storage
LIGHTDASH_S3_PASSWORD=kies_een_apart_lightdash_opslagwachtwoord
